# Copy this file to .env and fill in real values. .env is git-ignored.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Neon connection string (Dashboard -> Connect). Used from Step 1 onward.
DATABASE_URL=

